# Wazuh Operator - Local Development Environment Configuration
# Copy this file to .env and customize as needed
# Usage: source .env && ./scripts/deploy-local.sh

#==============================================================================
# Minikube Configuration
#==============================================================================

# Minikube profile name (allows multiple isolated environments)
MINIKUBE_PROFILE=wazuh-dev

# CPU allocation (minimum 4 recommended for profile S)
MINIKUBE_CPUS=4

# Memory allocation in MB (minimum 8GB recommended for profile S)
MINIKUBE_MEMORY=8192

# Disk size (minimum 40GB recommended)
MINIKUBE_DISK_SIZE=40g

# Minikube driver (docker, virtualbox, kvm2, etc.)
MINIKUBE_DRIVER=docker

#==============================================================================
# Cluster Sizing Profile
#==============================================================================

# Available profiles:
# - XS: Extra Small (minimal testing) - ~3Gi RAM, ~1.5 CPU
# - S:  Small (dev/test) - ~3.5-7Gi RAM, ~1.75-3.5 CPU
# - M:  Medium (small prod) - ~19Gi RAM, ~10 CPU
# - L:  Large (production) - ~44Gi RAM, ~22 CPU
# - XL: Extra Large (enterprise) - ~140Gi RAM, ~70 CPU

SIZING_PROFILE=S

#==============================================================================
# Image Configuration
#==============================================================================

# Operator image name
OPERATOR_IMAGE=wazuh-operator

# Image tag (leave empty for auto-generated timestamp)
# OPERATOR_TAG=dev-1234567890
OPERATOR_TAG=

#==============================================================================
# Namespace Configuration
#==============================================================================

# Operator namespace
OPERATOR_NAMESPACE=wazuh-system

# Cluster namespace
CLUSTER_NAMESPACE=wazuh

# Cluster name
CLUSTER_NAME=wazuh-cluster

#==============================================================================
# Helm Configuration
#==============================================================================

# Timeout for Helm operations
HELM_TIMEOUT=10m

#==============================================================================
# Quick Profiles
#==============================================================================
# Uncomment one of these profile blocks for quick setup

# Profile: Minimal (fast testing, minimal resources)
# MINIKUBE_CPUS=2
# MINIKUBE_MEMORY=4096
# MINIKUBE_DISK_SIZE=20g
# SIZING_PROFILE=XS

# Profile: Development (recommended for local dev)
# MINIKUBE_CPUS=4
# MINIKUBE_MEMORY=8192
# MINIKUBE_DISK_SIZE=40g
# SIZING_PROFILE=S

# Profile: Performance Testing
# MINIKUBE_CPUS=8
# MINIKUBE_MEMORY=16384
# MINIKUBE_DISK_SIZE=80g
# SIZING_PROFILE=M
